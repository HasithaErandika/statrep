# Copy to .env and fill in:  cp .env.example .env

# Schedule: comma-separated HH:MM times, every day
TZ=Asia/Colombo
CHECK_TIMES=06:00,07:45,16:30,20:00

# Email (Brevo SMTP; port 587 = STARTTLS, 465 = SSL)
# MAIL_FROM must be a verified sender in Brevo.
# MAIL_TO: one or more recipients, separated by commas. Each gets their own copy of the
# report, so recipients don't see each other's addresses. Example with 5 recipients:
#   MAIL_TO=ops@example.com,dev@example.com,manager@example.com,alerts@example.com,me@example.com
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-login@smtp-brevo.com
SMTP_PASS=your-smtp-key
MAIL_FROM=sender@example.com
MAIL_TO=wickramasinghe.erandika@gmail.com

# Checks
CHECK_TIMEOUT=20
CHECK_RETRIES=1
SLOW_MS=5000
API_SLOW_MS=2000
SSL_WARN_DAYS=14
DOMAIN_WARN_DAYS=30
# Parallelism. Each run first times every site/API (TIMING_CONCURRENCY at once, kept low so
# targets don't slow each other down and skew response times), then collects SSL, domain and
# page details for all of them (CHECK_CONCURRENCY at once).
TIMING_CONCURRENCY=10
CHECK_CONCURRENCY=40

# Secrets used in config/apis.yml as ${NAME}, for example:
# ORDERS_API_TOKEN=
# MONITOR_PASSWORD=

# Web UI port on the host. BIND=127.0.0.1 makes it reachable only via a local reverse proxy.
PORT=9090
BIND=0.0.0.0

# Abuse limits for the page
# Seconds between manual "Run check & send report" clicks
RUN_COOLDOWN=120
# Quick check requests per visitor IP per minute
QUICK_CHECKS_PER_MIN=6

# Optional login for the page (browser username/password prompt). Leave empty for no login.
AUTH_USER=
AUTH_PASSWORD=

# Behind a reverse proxy (nginx, Caddy): number of proxies, so rate limits see real visitor IPs
TRUSTED_PROXIES=0

# Optional: public URL of the dashboard, adds an "Open dashboard" button to emails
DASHBOARD_URL=
