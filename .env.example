# Copy to .env and fill in:  cp .env.example .env

# Schedule: comma-separated HH:MM times, every day
TZ=Asia/Colombo
CHECK_TIMES=07:30,19:30

# Email (Brevo SMTP; port 587 = STARTTLS, 465 = SSL)
# MAIL_FROM must be a verified sender in Brevo; MAIL_TO can be comma-separated
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-login@smtp-brevo.com
SMTP_PASS=your-smtp-key
MAIL_FROM=sender@example.com
MAIL_TO=wickramasinghe.erandika@gmail.com

# Checks
CHECK_TIMEOUT=20
CHECK_RETRIES=1
SLOW_MS=5000
SSL_WARN_DAYS=14
DOMAIN_WARN_DAYS=30

# Web UI port on the host
PORT=8080

# Optional: public URL of the dashboard, adds an "Open dashboard" button to emails
DASHBOARD_URL=
